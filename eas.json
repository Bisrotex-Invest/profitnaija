{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "node": "20.11.1",
      "install": {
        "command": "npm install"
      },
      "env": {
        "USE_NPM": "1"
      },
      "cache": {
        "key": "v5"
      }
    }
  }
}
