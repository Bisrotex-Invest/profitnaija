{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "node": "20.11.1",
      "env": {
        "USE_NPM": "1",
        "COREPACK_ENABLED": "0"
      },
      "cache": {
        "key": "v6"
      },
      "prebuildCommand": "npm install -g npm@10.2.5"
    }
  }
}
